    {
      "id": "unwrap_comparison",
      "url": "https://raw.githubusercontent.com/Frankencoin-ZCHF/FrankenCoin/c1f229e3b26050367aafcb55da294342b4cae382/contracts/equity/fps2/FPS2.sol",
      "source_sha256": "e9b5507df59e48a97d067bef61fd272bb5f51db7cc5100a77850fd5a454e9570",
      "quote": "if (holdingDuration(msg.sender) < averageHoldingDuration()) revert NotFIFO();"
    },
    {
      "id": "binding_comparison",
      "url": "https://raw.githubusercontent.com/Frankencoin-ZCHF/FrankenCoin/c1f229e3b26050367aafcb55da294342b4cae382/contracts/equity/fps2/FPS2.sol",
      "source_sha256": "e9b5507df59e48a97d067bef61fd272bb5f51db7cc5100a77850fd5a454e9570",
      "quote": "return FPS1.relativeVotes(address(this)) * 3 > 2e18;"
    },
    {
      "id": "redemption_gate",
      "url": "https://raw.githubusercontent.com/Frankencoin-ZCHF/FrankenCoin/c1f229e3b26050367aafcb55da294342b4cae382/contracts/equity/fps2/FPS2.sol",
      "source_sha256": "e9b5507df59e48a97d067bef61fd272bb5f51db7cc5100a77850fd5a454e9570",
      "quote": "return isBinding() && FPS1.canRedeem(address(this));"
    },
    {
      "id": "legacy_age",
      "url": "https://raw.githubusercontent.com/Frankencoin-ZCHF/FrankenCoin/c1f229e3b26050367aafcb55da294342b4cae382/contracts/equity/Equity.sol",
      "source_sha256": "72b6f820fa242d0e373370ed3fda976151a2dbe56e81883fb3b47a3cd0bb8629",
      "quote": "return _anchorTime() - voteAnchor[owner] >= MIN_HOLDING_DURATION;"
    },
    {
      "id": "total_assets",
      "url": "https://raw.githubusercontent.com/Frankencoin-ZCHF/FrankenCoin/c1f229e3b26050367aafcb55da294342b4cae382/contracts/equity/fps2/FPS2MintRedeem.sol",
      "source_sha256": "065c33d54659220e7014f7c3995334678226ce69860c1eff94bda7b34460226b",
      "quote": "return ZCHF.equity() * totalSupply() / FPS1.totalSupply();"
    },
    {
      "id": "withdraw_cap",
